# ---------------------------------------------------------------
# BEAUTY WAVE 2026 참가업체 정보 취합 시스템 — 환경변수
# 로컬: 이 파일을 .env.local 로 복사해 값을 채우세요.
# 배포: Vercel > Project > Settings > Environment Variables 에 같은 이름으로 입력하세요.
# 아래 값은 모두 "서버 전용" 입니다. NEXT_PUBLIC_ 접두어를 붙이지 마세요.
# ---------------------------------------------------------------

# Supabase > Project Settings > API (또는 Data API) 의 Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys 의 service_role 키(legacy) 또는 Secret key(sb_secret_...)
# 절대 브라우저 코드나 공개 저장소에 노출하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 관리자 로그인 비밀번호 (10자 이상, 영문·숫자·기호 섞어서)
ADMIN_PASSWORD=

# 세션 서명용 비밀값 (32자 이상 임의 문자열)
# 생성 예) node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# (선택) 링크 목록 엑셀에 들어갈 사이트 주소. 비우면 접속한 주소를 사용합니다.
# APP_BASE_URL=https://beautywave2026.vercel.app
